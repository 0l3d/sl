use("io", "math")

io.print("POW 1 (2^3): ", math.pow(2, 3), "\nPOW 2 (5^-1): ", math.pow(5, -1), "\n\n")

io.print("SQRT 1 (sqrt 16): ", math.sqrt(16), "\nSQRT 2 (sqrt 2): ", math.sqrt(2), "\n\n")

io.print("ABS 1 (abs -15.5): ", math.abs(-15.5), "\nABS 2 (abs 10): ", math.abs(10), "\n\n")

io.print("FLOOR 1 (floor 4.9): ", math.floor(4.9), "\nFLOOR 2 (floor -2.3): ", math.floor(-2.3), "\n\n")

io.print("CEIL 1 (ceil 4.1): ", math.ceil(4.1), "\nCEIL 2 (ceil -2.8): ", math.ceil(-2.8), "\n\n")

io.print("ROUND 1 (round 4.4): ", math.round(4.4), "\nROUND 2 (round 4.5): ", math.round(4.5), "\n\n")

io.print("SIN (sin 0): ", math.sin(0), "\nCOS (cos 0): ", math.cos(0), "\nTAN (tan 45deg): ", math.tan(0.785398), "\n\n")

io.print("LOG (ln e): ", math.log(2.7182818), "\nLOG10 (log10 100): ", math.log10(100), "\n\n")

io.print("MIN (min 12, 45.5): ", math.min(12, 45.5), "\nMAX (max -5, -2): ", math.max(-5, -2), "\n")
